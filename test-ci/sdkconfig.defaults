CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT=n
# Unity tests run in the main task. The IDF default (3584 B) is too small for
# suites that use larger value structs (e.g. pool_session's ~1 KB PoolSession);
# match the main firmware's 8 KB so tests have adequate stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# pool_time asserts on 64-bit epochs/monotonic values; without this Unity's
# 64-bit assertions always fail ("Unity 64-bit Support Disabled").
CONFIG_UNITY_ENABLE_64BIT=y