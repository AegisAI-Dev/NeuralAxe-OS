menu "Bitaxe Configuration"

    menu "GPIO Pin Configuration"

        config GPIO_BUTTON_BOOT
            int "Boot button GPIO pin"
            default 0
            help
                GPIO pin connected to the BOOT button.

        config GPIO_ASIC_RESET
            int "ASIC reset GPIO pin"
            default 1
            help
                GPIO pin for ASIC_RESET (RST_N), reset input to ASIC.

        config GPIO_ASIC_ENABLE
            int "ASIC enable GPIO pin"
            default 10
            help
                GPIO pin for ASIC_ENABLE (POWER_EN), enable for core power supply.

        config GPIO_PLUG_SENSE
            int "Barrel plug sense GPIO pin"
            default 12
            help
                GPIO pin for DC barrel (PLUG_SENSE), sense pin of DC power jack socket.

        config GPIO_I2C_SDA
            int "I2C SDA Pin"
            default 47
            help
                GPIO pin for I2C clock line (SDA).
            
        config GPIO_I2C_SCL
            int "I2C SCL Pin"
            default 48
            help
                GPIO pin for I2C clock line (SCL).
        config GPIO_BAP_RX
            int "I2C BAP Pin"
            default 40
            help
                GPIO pin for BAP receiving line.
        config GPIO_BAP_TX
            int "I2C BAP Pin"
            default 39
            help
                GPIO pin for BAP transmitting line.
            
    endmenu
    
    config ASIC_VOLTAGE
        int "ASIC Core Voltage (mV)"
        range 1000 1800
        default 1400
        help
            The core voltage to set the ASIC to. 1200 for BM1366 or 1400 for BM1397 is typical.

    config ASIC_FREQUENCY
        int "ASIC Hash Frequency (MHz)"
        range 50 800
        default 250
        help
            The BM1397 hash frequency
endmenu

menu "Stratum Configuration"

    config STRATUM_URL
        string "Stratum Address"
        default "public-pool.io"
        help
            The example will connect to this Stratum pool address.

    config STRATUM_PORT
        int "Stratum Port"
        range 0 65535
        default 21496
        help
            The stratum server port to connect to.
    
    choice
        prompt "Stratum TLS mode"
        default STRATUM_TLS_DISABLED
        help
            Select how TLS is used for stratum connections.

        config STRATUM_TLS_DISABLED
            bool "Disabled"

        config STRATUM_TLS_BUNDLED
            bool "Enabled (bundled CA certificate)"

        config STRATUM_TLS_CUSTOM
            bool "Enabled (user-provided/custom CA certificate)"
    endchoice

    config STRATUM_TLS
        int
        default 0 if STRATUM_TLS_DISABLED
        default 1 if STRATUM_TLS_BUNDLED
        default 2 if STRATUM_TLS_CUSTOM
    
    config STRATUM_CERT
        string "Stratum Certificate"
        default "x"
        help
            The certificate to use with the stratum connection.

    config EXTRANONCE_SUBSCRIBE
        bool "Pool extranonce subscribe"
        default n
        help
            Enable stratum extranonce subscribe.

    config FALLBACK_STRATUM_URL
        string "Fallback Stratum Address"
        default "solo.ckpool.org"
        help
            The example will connect to this Stratum pool address if the primary fails.

    config FALLBACK_STRATUM_PORT
        int "Fallback Stratum Port"
        range 0 65535
        default 3333
        help
            The stratum server port to connect to if the primary fails.
    
    choice
        prompt "Fallback Stratum TLS mode"
        default FALLBACK_STRATUM_TLS_DISABLED
        help
            Select how TLS is used for stratum connections.

        config FALLBACK_STRATUM_TLS_DISABLED
            bool "Disabled"

        config FALLBACK_STRATUM_TLS_BUNDLED
            bool "Enabled (bundled CA certificate)"

        config FALLBACK_STRATUM_TLS_CUSTOM
            bool "Enabled (user-provided/custom CA certificate)"
    endchoice

    config FALLBACK_STRATUM_TLS
        int
        default 0 if FALLBACK_STRATUM_TLS_DISABLED
        default 1 if FALLBACK_STRATUM_TLS_BUNDLED
        default 2 if FALLBACK_STRATUM_TLS_CUSTOM
    
    config FALLBACK_STRATUM_CERT
        string "Fallback Stratum Certificate"
        default "x"
        help
            The certificate to use with the stratum connection if the primary fails.

    config FALLBACK_EXTRANONCE_SUBSCRIBE
        bool "Fallback pool extranonce subscribe"
        default n
        help
            Enable fallback pool extranonce subscribe.

    config STRATUM_USER
        string "Stratum username"
        default "replace-this-with-your-btc-address.bitaxe"
        help
            Stratum user to use with pool

    config STRATUM_PW
        string "Stratum password"
        default "x"
        help
            Stratum password to use with pool

    config FALLBACK_STRATUM_USER
        string "Fallback Stratum username"
        default "replace-this-with-your-btc-address.bitaxe"
        help
            Fallback Stratum user to use with pool

    config FALLBACK_STRATUM_PW
        string "Fallback Stratum password"
        default "x"
        help
            Fallback Stratum password to use with pool

    config STRATUM_DIFFICULTY
        int "Stratum default difficulty"
        range 0 4294967296
        default 1000
        help
            A starting difficulty to use with the pool.

    config FALLBACK_STRATUM_DIFFICULTY
        int "Fallback stratum default difficulty"
        range 0 4294967296
        default 1000
        help
            A starting difficulty to use with the fallback pool.

    config ENABLE_TASK_MONITOR
        bool "Task Monitor"
        default n
        help
            Enable task monitor. NOTE: This is intended for debugging use only as the use of uxTaskGetSystemState results in the scheduler remaining suspended for an extended period.

    config NX_TIMED_SESSIONS
        bool "NeuralAxe timed pool sessions (EXPERIMENTAL, board 601 / BM1370 only)"
        default n
        help
            EXPERIMENTAL. Enables device-side unattended timed pool sessions
            (NeuralAxe Phase 2M.1B). Board 601 / BM1370 only. Disabled by default.

            Gate B6 is the first gate that wires runtime behavior to this flag: it
            loads the persisted session store during boot, plans boot recovery,
            bootstraps the single operation coordinator and HOLDS protocol/Stratum
            startup for every unresolved session posture. It still performs NO pool
            configuration change, NO restoration, NO Stratum control, NO target
            mining authorization, NO OTA and NO restart - those belong to Gate B7.

            With the flag disabled nothing changes: no runtime instance, no runtime
            task, the nx_tps namespace is never opened, SNTP is never initialized and
            protocol startup is unchanged. Leave disabled for production until the
            later gates integrate controlled apply, restore and the API.

    config NX_TIMED_SESSIONS_NTP_SERVER
        string "Trusted-time (SNTP) server for timed pool sessions"
        depends on NX_TIMED_SESSIONS
        default ""
        help
            Product-configured SNTP server used ONLY to establish trusted time for
            timed pool session deadlines after a reboot.

            DELIBERATELY EMPTY BY DEFAULT. No public NTP hostname is baked into the
            firmware. While this is empty the runtime reports an unconfigured time
            source and keeps protocol startup HELD whenever boot recovery requires
            trusted time - it never invents trust and never contacts a server that
            the product has not explicitly chosen. Selecting a server is an open
            product decision (privacy, availability and jurisdiction).

            Accepted values (Gate B10 bounded validation): a dotted DNS hostname
            of at least two labels drawn only from [A-Za-z0-9.-], or a dotted-quad
            IPv4 literal without leading zeros. URL schemes, paths, credentials,
            whitespace, control characters, single-label names and IPv6 literals
            are rejected, and a rejected value behaves exactly like an empty one:
            no DNS lookup and no SNTP start ever happen.

            Note: standard SNTP/DNS is not cryptographically authenticated (no NTS,
            no DNSSEC). See components/pool_time/include/pool_time.h for the exact
            trust boundary and the documented network-trust residual.

    config NX_TIMED_SESSIONS_TIME_OBSERVE
        bool "Timed pool session trusted-time OBSERVATION only (EXPERIMENTAL, Gate B10)"
        depends on NX_TIMED_SESSIONS
        default n
        help
            EXPERIMENTAL. Starts the trusted-time (SNTP) provider after network
            readiness purely to OBSERVE and validate trusted time on a real device,
            so a supervised pilot can confirm the time foundation before any timed
            session is ever created. Board 601 / BM1370 only. Disabled by default.

            This is a FOURTH, independent safety flag and it authorizes NOTHING.
            With it enabled the device still creates no session, applies no target
            pool configuration, restores nothing, acquires no operation lease,
            writes no session record, commits no heartbeat, changes no ASIC gate,
            grants no target mining and never restarts. It does not require the
            Gate B7 execution flag or the Gate B8 API flag, and it never turns an
            empty session store into a session store.

            Observation runs only on a device with NO session owner: an empty or
            cleared store. Normal source/default mining and protocol startup are
            byte-for-byte unchanged whether the synchronization succeeds, times
            out or never starts because no source is configured.

            With CONFIG_NX_TIMED_SESSIONS_NTP_SERVER empty no network request is
            made at all and the status simply reports an unconfigured source.

    config NX_TIMED_SESSIONS_TIME_OBSERVE_PILOT_DIAGNOSTICS
        bool "Timed pool session observation-pilot diagnostics (EXPERIMENTAL, Gate B10.1)"
        depends on NX_TIMED_SESSIONS_TIME_OBSERVE
        default n
        help
            EXPERIMENTAL. Adds bounded, read-only serial diagnostics for a
            supervised trusted-time OBSERVATION pilot, so the owner can watch a
            real device without a dashboard, without an HTTP route and without
            enabling the Gate B8 API. Board 601 / BM1370 only. Disabled by
            default and never auto-enabled.

            This is a FIFTH, independent safety flag and it authorizes NOTHING.
            It only observes already-published bounded facts on the single Gate
            B6 owner task and writes bounded machine-token log lines: the
            trusted-time source lifecycle, network/link readiness, the
            observation summary, and an invariant report of the healthy
            empty-store posture. It creates no task, registers no event
            handler, opens no socket, writes no NVS, changes no public schema,
            never runs from an interrupt and never holds a lock across a log
            call or an external call.

            A detected invariant violation is REPORTED, never acted upon: it
            never restarts the device, clears a record, changes the pool
            configuration or stops mining. Acting on it is the owner's decision.

            No log line can carry the configured trusted-time hostname, a
            resolved address, a raw wall-clock epoch, a pool identity, an
            account, a worker, a password, a session identifier, a lease token
            or a record generation - the diagnostic models have no string field
            and the formatters accept no string input.

            With this flag disabled the firmware is byte-for-byte the committed
            Gate B10 build: no pilot symbol is linked and no pilot line is
            emitted. Leave disabled for production; enable it only for an
            owner-built, owner-flashed pilot artifact.

    config NX_TIMED_SESSIONS_EXECUTION
        bool "Timed pool session controlled execution (EXPERIMENTAL, Gate B7)"
        depends on NX_TIMED_SESSIONS
        default n
        help
            EXPERIMENTAL. Enables the Gate B7 controlled-execution layer for
            timed pool sessions: bounded target/source configuration
            transactions with independent readback, controlled protocol
            stop/reconfigure/start, live target verification before the first
            target-mining grant, initial health monitoring, and verified
            source restoration. Board 601 / BM1370 only. Disabled by default.

            This is a SECOND, independent safety flag: NX_TIMED_SESSIONS may
            stay enabled while this stays disabled, in which case Gate B6
            remains a hold-only runtime - no pool configuration write, no
            protocol verification connection, no controlled reconnect, no
            target-mining grant, no restart, and no B7 executor or singleton
            exists at all.

            Session creation over HTTP remains out of scope even with this
            flag enabled (Gate B8 owns the API surface). Leave disabled
            for production.

    config NX_TIMED_SESSIONS_API
        bool "Timed pool session HTTP control API (EXPERIMENTAL, Gate B8)"
        depends on NX_TIMED_SESSIONS && NX_TIMED_SESSIONS_EXECUTION
        default n
        help
            EXPERIMENTAL. Enables the Gate B8 timed-session control-plane API:
            a sanitized read-only status route, bounded session creation,
            Restore Now, terminal acknowledgement, and the standardized
            HTTP 409 conflict body for the existing pool PATCH / restart /
            OTA ownership fences. Board 601 / BM1370 only. Disabled by
            default and never auto-enabled.

            This is a THIRD, independent safety flag. HTTP handlers only
            VALIDATE requests and submit bounded commands to the single
            Gate B6 runtime owner task: no handler applies pool
            configuration, starts or stops Stratum, grants ASIC mining,
            restarts the device or writes the session store. No request may
            carry a password (Keep-current-password only), a source
            identity, a session id or a lease token, and no response
            exposes a pool host, account, worker, wallet, session id,
            generation or lease token.

            With this flag disabled no API route is registered, no command
            queue or API singleton exists and Gates B6/B7 behave exactly as
            committed. Leave disabled for production.

            The API is reachable only through the existing private-network
            admission check; it is NOT user-authenticated, and HTTP 409 is
            conflict reporting rather than access control. See
            docs/NEURALAXE_PHASE_2M1A_TIMED_POOL_SESSIONS_SECURITY.md.

endmenu
